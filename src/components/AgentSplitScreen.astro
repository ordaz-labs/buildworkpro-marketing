---
// The "agent on a phone, BuildWorkPro on the desk" visual used in the homepage
// hero and on /agents/. The chat is the office role on Grok Bot: it reads the
// inbox and calendar through Grok Bot's own connectors and files the results
// in BuildWorkPro through MCP (leads_create, contacts_update,
// lead_activities_create). Every line is something those tools can do —
// nothing here claims a capability the product doesn't have. Names are
// illustrative, not customers.
interface Props {
  class?: string;
  /** Load the screenshot eagerly (hero) instead of lazily. */
  eager?: boolean;
}

const { class: className = '', eager = false } = Astro.props;

const messages: { from: 'agent' | 'you'; text: string; time: string }[] = [
  {
    from: 'agent',
    text: 'Morning. Two GC emails overnight look like real work. Created leads for the storefront job and the curtain wall RFI, contacts linked.',
    time: '6:40 AM',
  },
  {
    from: 'agent',
    text: 'The storefront GC wants a walkthrough Thursday 9 AM. It’s on your calendar. Bid due the 19th, set on the lead.',
    time: '6:41 AM',
  },
  {
    from: 'you',
    text: 'Draft the walkthrough confirmation and ask about the glass spec.',
    time: '7:05 AM',
  },
  {
    from: 'agent',
    text: 'Draft is in your inbox for review. Logged it on the lead.',
    time: '7:05 AM',
  },
];
---

<div class={`relative grid grid-cols-1 sm:grid-cols-[180px_minmax(0,1fr)] items-end ${className}`}>
  <!-- Phone: the agent -->
  <div
    class="relative z-10 mx-auto sm:mx-0 w-[180px] rounded-[26px] bg-slate-950 p-2 shadow-2xl shadow-slate-900/30"
    aria-label="Example chat with an office agent running on Grok Bot"
  >
    <div class="rounded-[20px] bg-zinc-100 overflow-hidden flex flex-col h-[330px]">
      <div class="bg-black text-white px-2.5 pt-3 pb-2 flex items-center gap-2">
        <span
          class="w-5 h-5 rounded-full bg-gradient-to-br from-amber-400 to-orange-600 shrink-0"
          aria-hidden="true"></span>
        <span class="leading-tight">
          <span class="block text-[10.5px] font-semibold">Office Bot</span>
          <span class="block text-[8.5px] opacity-80">Grok Bot · always on</span>
        </span>
      </div>
      <ol class="flex-1 p-2 flex flex-col gap-1.5 overflow-hidden list-none m-0">
        {
          messages.map((m) => (
            <li
              class={`max-w-[88%] rounded-lg px-2 py-1.5 text-[9px] leading-snug text-slate-900 shadow-sm ${
                m.from === 'you' ? 'self-end bg-zinc-200' : 'bg-white'
              }`}
            >
              {m.text}
              <span class="block text-[7px] text-slate-400 text-right mt-0.5">{m.time}</span>
            </li>
          ))
        }
      </ol>
      <div class="bg-zinc-200/70 px-2 py-1.5 flex items-center gap-1.5">
        <span
          class="flex-1 bg-white rounded-full h-[18px] text-[8px] text-slate-400 flex items-center pl-2"
          >Message Office Bot</span
        >
        <span class="w-[18px] h-[18px] rounded-full bg-black" aria-hidden="true"></span>
      </div>
    </div>
  </div>

  <!-- Browser: BuildWorkPro -->
  <div
    class="relative sm:-ml-14 -mt-10 sm:mt-0 rounded-2xl overflow-hidden border border-slate-200/80 shadow-2xl shadow-slate-900/15 bg-slate-900"
  >
    <div class="flex items-center gap-1.5 px-3 py-2 bg-slate-800">
      <span class="w-2 h-2 rounded-full bg-slate-600"></span>
      <span class="w-2 h-2 rounded-full bg-slate-600"></span>
      <span class="w-2 h-2 rounded-full bg-slate-600"></span>
      <span
        class="flex-1 ml-2 bg-slate-700 rounded px-2 py-0.5 text-[10px] text-slate-400 text-center"
        >app.buildworkpro.com/leads</span
      >
    </div>
    <img
      src="/screenshots/02-pipeline-kanban.png"
      alt="BuildWorkPro sales pipeline with new leads created by an AI agent"
      width="1920"
      height="1080"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
      class="w-full h-auto block"
    />
  </div>
</div>
