---
import { config } from '../config';

interface RelatedLink {
  href: string;
  title: string;
  description: string;
}

interface Props {
  headline: string;
  description: string;
  datePublished: string; // ISO 8601, e.g. '2026-03-10'
  /** ISO 8601 — set when a post gets a real content update. */
  dateModified?: string;
  related?: RelatedLink[];
}

const { headline, description, datePublished, dateModified, related = [] } = Astro.props;
const { author } = config;

const articleUrl = Astro.url.href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline,
  description,
  datePublished,
  dateModified: dateModified ?? datePublished,
  image: ogImage,
  url: articleUrl,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  author: {
    '@type': 'Person',
    name: author.name,
    jobTitle: author.jobTitle,
    url: new URL(author.url, config.siteUrl).href,
    ...(author.profiles.length > 0 && { sameAs: author.profiles.map((p) => p.href) }),
    worksFor: { '@type': 'Organization', name: 'BuildWorkPro', url: config.siteUrl },
  },
  publisher: {
    '@type': 'Organization',
    name: 'BuildWorkPro',
    url: config.siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${config.siteUrl}/logo.png`,
    },
  },
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />

<section
  aria-label="About the author"
  class="mt-16 p-6 rounded-xl border border-slate-100 bg-slate-50"
>
  <p class="text-xs font-semibold text-slate-400 uppercase tracking-wider mb-2">Written by</p>
  <p class="text-base font-semibold text-slate-900">
    <a href={author.url} class="hover:text-brand-600">{author.name}</a>
    <span class="font-normal text-slate-500"> · {author.jobTitle}</span>
  </p>
  <p class="mt-2 text-sm text-slate-600 leading-relaxed">{author.bio}</p>
  <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium">
    <a href={author.url} class="text-brand-600 hover:text-brand-700">Why I built BuildWorkPro</a>
    {
      author.profiles.map((p) => (
        <a
          href={p.href}
          rel="me noopener"
          target="_blank"
          class="text-brand-600 hover:text-brand-700"
        >
          {p.label}
        </a>
      ))
    }
  </p>
</section>

{
  related.length > 0 && (
    <section aria-labelledby="related-heading" class="mt-16 pt-12 border-t border-slate-100">
      <h2 id="related-heading" class="text-2xl font-bold text-slate-900 mb-8 tracking-tight">
        Keep reading
      </h2>
      <div class="grid sm:grid-cols-2 gap-6">
        {related.map((link) => (
          <a
            href={link.href}
            class="group block p-6 rounded-xl border border-slate-100 hover:border-slate-200 hover:shadow-md transition-all"
          >
            <h3 class="text-base font-semibold text-slate-900 mb-2 group-hover:text-brand-600 transition-colors">
              {link.title}
            </h3>
            <p class="text-sm text-slate-500 leading-relaxed">{link.description}</p>
            <span class="inline-flex items-center text-sm font-medium text-brand-600 mt-3 group-hover:gap-2 gap-1.5 transition-all">
              Learn more
              <svg
                class="w-4 h-4"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}
