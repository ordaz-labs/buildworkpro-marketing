---
// Agents-first hero (marketing#183, direction B). The H1 carries the thesis;
// the ranking phrase "Project management software for subcontractors" stays in
// the first sentence of the subhead and in the page title, so the SEO anchor
// does not move. The visual is the same phone-plus-app frame the demo videos
// and ad creatives use.
import { config } from '../config';
import AgentSplitScreen from './AgentSplitScreen.astro';
---

<section class="relative pt-32 pb-20 lg:pt-40 lg:pb-28 overflow-hidden">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-brand-50 via-white to-slate-50 -z-10"></div>
  <div
    class="absolute top-0 right-0 w-[600px] h-[600px] bg-brand-100/40 rounded-full blur-3xl -z-10 translate-x-1/2 -translate-y-1/2"
  >
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] gap-12 lg:gap-16 items-center">
      <div class="max-w-2xl">
        <h1
          class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-900 leading-[1.1] text-balance"
        >
          Your agents do the work.
          <span
            class="block text-transparent bg-clip-text bg-gradient-to-r from-brand-600 to-brand-400"
          >
            BuildWorkPro keeps the record.
          </span>
        </h1>

        <p class="mt-6 text-lg sm:text-xl text-slate-600 leading-relaxed">
          Project management software for subcontractors, built to be operated by AI agents. Connect
          Claude, ChatGPT, Grok Bot, OpenClaw or Hermes Agent. They build the bids, work the inbox
          and keep the CRM current. Every result lands in one permissioned account that you review.
        </p>

        <div class="mt-10 flex flex-col sm:flex-row items-center gap-4">
          <a
            href={config.signupUrl}
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-white bg-brand-600 hover:bg-brand-700 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <a
            href="/agents/"
            class="w-full sm:w-auto inline-flex items-center justify-center px-8 py-3.5 text-base font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 rounded-xl transition-all hover:-translate-y-0.5"
          >
            See how agents run it
          </a>
        </div>

        <p class="mt-5 text-sm text-slate-400">
          $79/month flat · unlimited users · 14-day free trial · no credit card required
        </p>
      </div>

      <AgentSplitScreen eager />
    </div>
  </div>
</section>
