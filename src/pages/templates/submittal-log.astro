---
// Submittal log — submittal log ~170/mo KD0 (issue #145 optional hub addition). Ungated per Q5.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { config } from '../../config';

const FILE = '/templates-files/submittal-log-template.xlsx';

const whatsInside = [
  '40 rows: spec section, description, type, revision, dates, status, reviewer',
  'Live counts of Not Submitted / Submitted / Approved / Revise-Rejected',
  'Dropdowns for type (product data, shop drawings, samples, mock-up) and status',
  'Lead-time and action-required-by columns so nothing sits in limbo',
  'Sample storefront rows showing the level of detail reviewers expect',
  'Landscape print layout that still fits a tabloid sheet',
];

const faqs = [
  {
    question: 'What is a submittal log?',
    answer:
      'The running register of every product data sheet, shop drawing, sample, and mock-up you owe the architect or GC — numbered, dated, and statused so you can see what is still outstanding before it delays fabrication or installation.',
  },
  {
    question: 'What belongs on a construction submittal?',
    answer:
      'Whatever the spec section requires: product data, shop drawings, samples, mock-ups, calculations. Each item gets its own row (and a new row for each revision). Mixing three products onto one line is how "approved as noted" becomes an argument about which note applied to which item.',
  },
  {
    question: 'When should I submit?',
    answer:
      "Early enough that review time plus fabrication lead time still hits the install date. The template's lead-time column exists so you work backwards from the need-by date instead of discovering a 6-week glass lead after the opening is framed.",
  },
  {
    question: 'What do the status values mean?',
    answer:
      'Not Submitted (still in your court), Submitted (with the reviewer), Approved, Approved as Noted (install to the markups), Revise and Resubmit, Rejected. Counts at the top only work if you use those exact phrases — they are in the dropdown.',
  },
];
---

<Layout
  title="Free Construction Submittal Log Template (Excel)"
  description="Free construction submittal log: 40-row Excel tracker with status counts, type dropdowns, lead time, and reviewer columns. No email required."
>
  <Header />
  <main class="pt-32 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
          Free template
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
          Construction Submittal Log Template
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          A 40-row register of every shop drawing, product data sheet, and sample you owe — with
          status counts so outstanding reviews are visible before they delay the job.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={FILE}
            download
            data-template="submittal-log"
            class="template-download inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Download the free template (.xlsx)
          </a>
          <a
            href="/templates/"
            class="inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm hover:border-brand-300 hover:text-brand-700 transition-colors"
          >
            See all free templates
          </a>
        </div>
        <p class="mt-3 text-center text-sm text-slate-500">
          No email required · Works in Excel, Google Sheets &amp; Numbers
        </p>
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">
        What's in the template
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          whatsInside.map((item) => (
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-brand-600 mt-0.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-600">{item}</span>
            </div>
          ))
        }
      </div>
      <p
        class="mt-8 text-sm text-slate-500 text-center max-w-2xl mx-auto"
        set:html={`Unclear drawings usually surface here first — write them up with the <a href="/templates/rfi/" class="text-brand-600 underline underline-offset-2 font-medium">RFI template</a> instead of stalling the submittal.`}
      />
    </section>

    <FAQSection faqs={faqs} />

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-20">
      <div class="rounded-2xl bg-slate-900 px-8 py-14 sm:px-14">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight text-balance">
          Submittals that sit on the project, not a hidden spreadsheet
        </h2>
        <p class="mt-4 text-slate-400 max-w-xl mx-auto">
          BuildWorkPro keeps project documents, tasks, and closeout in one place so shop drawings
          and product data are not a side spreadsheet nobody opens.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={config.signupUrl}
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <a
            href="/features/project-management/"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-white/10 text-white font-semibold text-sm hover:bg-white/20 transition-colors"
          >
            See project management in BuildWorkPro
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-500">
          <a href="/pricing/" class="text-slate-300 underline hover:text-white">$79/month flat</a> · 14-day
          free trial · No credit card required
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
