---
// T&M ticket — T&M ticket ~250/mo KD0 (issue #145 optional hub addition). Ungated per Q5.
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FAQSection from '../../components/FAQSection.astro';
import { config } from '../../config';

const FILE = '/templates-files/tm-ticket-template.xlsx';

const whatsInside = [
  'Project, ticket number, date, location, and the directive that triggered the work',
  'Labor rows with hours × rate and overtime at time-and-a-half',
  'Materials rows with qty × unit cost',
  'Equipment rows with hours/days × rate',
  'A ticket total that sums labor, OT, materials, and equipment',
  'Dual signature blocks — unsigned extra work is not a change order',
];

const faqs = [
  {
    question: 'What is a T&M ticket?',
    answer:
      'A time-and-material ticket records extra work the same day it happens: who worked, for how long, at what rate, plus materials and equipment. It is the backup behind a change order when the GC directed work that was not in the original scope.',
  },
  {
    question: 'Is a signed T&M ticket a change order?',
    answer:
      'Not by itself. A T&M ticket documents cost. A change order adjusts the contract sum (and usually the schedule). Get the ticket signed the day of the work, then roll it into a change order so the new amount shows up on the next pay application.',
  },
  {
    question: 'What if the GC directed the work but will not sign the ticket?',
    answer:
      "Write a confirming email the same day, note it in your daily report, and keep the ticket anyway with 'directed, not signed' in the notes. Doing the work with no record is the worst position; a refused signature is still a record of the refusal.",
  },
  {
    question: 'How should I price T&M labor?',
    answer:
      "Use the rates in your subcontract if they exist; otherwise agree rates in writing before the extra work starts. The template computes hours × rate and overtime at 1.5× — do not leave the math to a later argument about what 'the usual rate' was.",
  },
];
---

<Layout
  title="Free Construction T&M Ticket Template (Excel)"
  description="Free construction T&M ticket: labor, materials, and equipment with computed totals and dual signatures. Excel workbook, no email required."
>
  <Header />
  <main class="pt-32 pb-20">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 mb-16">
      <div class="text-center">
        <p class="text-sm font-semibold text-brand-600 uppercase tracking-wider mb-3">
          Free template
        </p>
        <h1 class="text-4xl sm:text-5xl font-extrabold text-slate-900 tracking-tight text-balance">
          Construction T&amp;M Ticket Template
        </h1>
        <p class="mt-6 text-lg text-slate-500 max-w-2xl mx-auto leading-relaxed">
          Record extra work the day it happens: labor, overtime, materials, and equipment with the
          math done for you — then attach it to the change order that actually adjusts the contract.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href={FILE}
            download
            data-template="tm-ticket"
            class="template-download inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Download the free template (.xlsx)
          </a>
          <a
            href="/templates/change-order/"
            class="inline-flex w-full sm:w-auto items-center justify-center px-7 py-3 rounded-xl border border-slate-200 text-slate-700 font-semibold text-sm hover:border-brand-300 hover:text-brand-700 transition-colors"
          >
            Next step: the change order template
          </a>
        </div>
        <p class="mt-3 text-center text-sm text-slate-500">
          No email required · Works in Excel, Google Sheets &amp; Numbers
        </p>
      </div>
    </section>

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 mb-20">
      <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 text-center mb-10">
        What's in the template
      </h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {
          whatsInside.map((item) => (
            <div class="flex items-start gap-3">
              <svg
                class="w-5 h-5 text-brand-600 mt-0.5 shrink-0"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-slate-600">{item}</span>
            </div>
          ))
        }
      </div>
      <p
        class="mt-8 text-sm text-slate-500 text-center max-w-2xl mx-auto"
        set:html={`A signed ticket still has to become a <a href="/templates/change-order/" class="text-brand-600 underline underline-offset-2 font-medium">change order</a> before it bills on a <a href="/templates/aia-g702-g703/" class="text-brand-600 underline underline-offset-2 font-medium">pay application</a>.`}
      />
    </section>

    <FAQSection faqs={faqs} />

    <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center mt-20">
      <div class="rounded-2xl bg-slate-900 px-8 py-14 sm:px-14">
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight text-balance">
          Extra work that becomes a signed change order, not a forgotten ticket
        </h2>
        <p class="mt-4 text-slate-400 max-w-xl mx-auto">
          BuildWorkPro turns field extra work into a change order the customer approves online —
          then the new amount lands on the contract sum and the next pay application.
        </p>
        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={config.signupUrl}
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-semibold text-sm transition-all hover:-translate-y-0.5 hover:shadow-lg"
          >
            Start free trial
          </a>
          <a
            href="/features/change-orders/"
            class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-white/10 text-white font-semibold text-sm hover:bg-white/20 transition-colors"
          >
            See change orders in BuildWorkPro
          </a>
        </div>
        <p class="mt-6 text-sm text-slate-500">
          <a href="/pricing/" class="text-slate-300 underline hover:text-white">$79/month flat</a> · 14-day
          free trial · No credit card required
        </p>
      </div>
      <p class="mt-8 text-xs text-slate-400 max-w-2xl mx-auto">
        Not legal advice — have your attorney review before relying on it. A T&amp;M ticket
        documents cost; it is not a change order until both parties sign one.
      </p>
    </section>
  </main>
  <Footer />
</Layout>
