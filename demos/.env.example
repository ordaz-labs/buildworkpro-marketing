# ElevenLabs API
ELEVENLABS_API_KEY=
# Default voice: "Adam" pre-made voice. Override with any voice_id from your library.
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Target app
BWP_DEMO_URL=http://localhost:7782
BWP_DEMO_EMAIL=
BWP_DEMO_PASSWORD=

# Render settings
DEMO_WIDTH=1920
DEMO_HEIGHT=1080
DEMO_FPS=30

# Capture behavior
# 0 = open a real browser window (needed for PDF preview scenes)
DEMO_HEADLESS=1
# With more than one organization membership, pin the tenant the demo signs into
BWP_DEMO_TENANT_ID=
# Only needed if the local Turnstile secret is a real key (dev normally uses the test key)
BWP_DEMO_TURNSTILE_TOKEN=

# Split-screen renders
# 16x9 | 9x16 to render one cut while iterating (default: both)
DEMO_ASPECT=
# 1 = allow rendering a script whose phone.transcriptStatus is still "draft" (rough cuts only)
DEMO_ALLOW_DRAFT_TRANSCRIPT=
